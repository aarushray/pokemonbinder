# Copy this file to ".env" (same folder) and fill in the key. .env is ignored by git; never commit it.
#
# Supabase secret key, used only by server.js for the admin Orders page. Find it in the Supabase
# dashboard: Project Settings -> API Keys -> "service_role" (Legacy API Keys tab) or a "secret" key
# (sb_secret_...). Never put this key in public/ or share it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: require this password for admin pages when the site is opened from another computer.
# ADMIN_PASSWORD=
